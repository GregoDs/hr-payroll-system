    {
      "name": "02 - Generate Draft Payroll",
      "item": [
        {
          "name": "Generate payroll as Draft",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pay_period\": \"{{payPeriod}}\"\n}"
            },
            "url": "{{baseUrl}}/api/payroll/generate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payroll generated or already exists on rerun', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json().data;",
                  "    pm.test('Generated records start as Draft', function () {",
                  "        pm.expect(data).to.be.an('array').that.is.not.empty;",
                  "        data.forEach(record => pm.expect(record.status).to.eql('Draft'));",
                  "    });",
                  "    const unpaid = data.find(record => record.employee_id === Number(pm.collectionVariables.get('unpaidEmployeeId')));",
                  "    const midMonth = data.find(record => record.employee_code === 'PAY-LIFE-MIDMONTH');",
                  "    pm.collectionVariables.set('draftPayrollId', data[0].id);",
                  "    if (unpaid) { pm.collectionVariables.set('unpaidPayrollId', unpaid.id); }",
                  "    if (midMonth) { pm.collectionVariables.set('midMonthPayrollId', midMonth.id); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Internal review can see Draft payroll",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payroll"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Internal payroll list returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const records = pm.response.json().data;",
                  "const currentPeriod = records.filter(record => record.pay_period === pm.collectionVariables.get('payPeriod'));",
                  "if (currentPeriod.length > 0) {",
                  "    const unpaid = currentPeriod.find(record => record.employee_id === Number(pm.collectionVariables.get('unpaidEmployeeId')));",
                  "    const midMonth = currentPeriod.find(record => record.employee_code === 'PAY-LIFE-MIDMONTH');",
                  "    pm.collectionVariables.set('draftPayrollId', currentPeriod[0].id);",
                  "    if (unpaid) { pm.collectionVariables.set('unpaidPayrollId', unpaid.id); }",
                  "    if (midMonth) { pm.collectionVariables.set('midMonthPayrollId', midMonth.id); }",
                  "}",
                  "pm.test('Internal list can include Draft payroll for review', function () {",
                  "    pm.expect(currentPeriod.length).to.be.above(0);",
                  "    pm.expect(currentPeriod.some(record => record.status === 'Draft')).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate generation returns 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pay_period\": \"{{payPeriod}}\"\n}"
            },
            "url": "{{baseUrl}}/api/payroll/generate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate payroll generation is blocked', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Draft Visibility Rules",
      "item": [
        {
          "name": "Draft payslip is blocked",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payroll/{{draftPayrollId}}/payslip"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Draft payslip returns 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Response explains payslip is not finalized', function () {",
                  "    pm.expect(pm.response.json().message).to.include('finalized');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Internal payroll by ID still sees Draft",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payroll/{{draftPayrollId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Internal payroll detail returns Draft', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.status).to.eql('Draft');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Employee history hides Draft period",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payroll/employee/{{unpaidEmployeeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Employee endpoint succeeds or has no visible records', function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const records = pm.response.json().data;",
                  "    pm.test('Draft current period is hidden from employee history', function () {",
                  "        const visibleDraft = records.find(record => record.pay_period === pm.collectionVariables.get('payPeriod') && record.status === 'Draft');",
                  "        pm.expect(visibleDraft).to.eql(undefined);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Finalize Payroll",
      "item": [
        {
          "name": "Finalize unpaid leave employee payroll",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"manager_id\": {{managerId}}\n}"
            },
            "url": "{{baseUrl}}/api/payroll/{{unpaidPayrollId}}/finalize"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Draft payroll finalizes or is already finalized on rerun', function () {",
                  "    pm.expect([200, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Status changed to Finalized', function () {",
                  "        pm.expect(pm.response.json().data.status).to.eql('Finalized');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Finalized payslip is visible",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payroll/{{unpaidPayrollId}}/payslip"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payslip returns 200 after finalization', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Payslip includes employee, earnings, deductions, and net pay', function () {",
                  "    const payslip = pm.response.json().data;",
                  "    pm.expect(payslip).to.have.property('employee');",
                  "    pm.expect(payslip).to.have.property('earnings');",
                  "    pm.expect(payslip).to.have.property('deductions');",
                  "    pm.expect(payslip).to.have.property('net_pay');",
                  "    pm.expect(['Finalized', 'Paid']).to.include(payslip.status);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Employee history now includes finalized period",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payroll/employee/{{unpaidEmployeeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Employee history returns visible payroll', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Finalized current period is visible', function () {",
                  "    const records = pm.response.json().data;",
                  "    const payroll = records.find(record => record.pay_period === pm.collectionVariables.get('payPeriod'));",
                  "    pm.expect(payroll).to.exist;",
                  "    pm.expect(['Finalized', 'Paid']).to.include(payroll.status);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cannot finalize the same payroll twice",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"manager_id\": {{managerId}}\n}"
            },
            "url": "{{baseUrl}}/api/payroll/{{unpaidPayrollId}}/finalize"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Second finalize returns 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Payroll Calculation Assertions",
      "item": [
        {
          "name": "Unpaid leave deduction was calculated",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payroll/{{unpaidPayrollId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unpaid leave payroll has deduction fields', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const payroll = pm.response.json().data;",
                  "    pm.expect(payroll.unpaid_leave_days).to.be.at.least(0);",
                  "    if (payroll.unpaid_leave_days > 0) {",
                  "        pm.expect(payroll.unpaid_leave_deduction).to.be.above(0);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Tax boundary and mid-month checks",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payroll"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payroll list returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const records = pm.response.json().data.filter(record => record.pay_period === pm.collectionVariables.get('payPeriod'));",
                  "const b24000 = records.find(record => record.employee_code === 'PAY-LIFE-24000');",
                  "const b50000 = records.find(record => record.employee_code === 'PAY-LIFE-50000');",
                  "const b100000 = records.find(record => record.employee_code === 'PAY-LIFE-100000');",
                  "const midMonth = records.find(record => record.employee_code === 'PAY-LIFE-MIDMONTH');",
                  "pm.test('24000 salary has zero tax', function () {",
                  "    pm.expect(b24000).to.exist;",
                  "    pm.expect(b24000.gross_pay).to.eql(24000);",
                  "    pm.expect(b24000.tax_deduction).to.eql(0);",
                  "});",
                  "pm.test('50000 salary has expected tax', function () {",
                  "    pm.expect(b50000).to.exist;",
                  "    pm.expect(b50000.gross_pay).to.eql(50000);",
                  "    pm.expect(b50000.tax_deduction).to.eql(2600);",
                  "});",
                  "pm.test('100000 salary has expected tax and uncapped social security', function () {",
                  "    pm.expect(b100000).to.exist;",
                  "    pm.expect(b100000.gross_pay).to.eql(100000);",
                  "    pm.expect(b100000.tax_deduction).to.eql(12600);",
                  "    pm.expect(b100000.social_security_deduction).to.eql(5000);",
                  "});",
                  "pm.test('Mid-month joiner is prorated', function () {",
                  "    pm.expect(midMonth).to.exist;",
                  "    pm.expect(midMonth.basic_salary).to.eql(90000);",
                  "    pm.expect(midMonth.gross_pay).to.eql(51000);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
